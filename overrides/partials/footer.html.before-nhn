{#-
  NHN Cloud Footer Override for mkdocs-material
  Level 3 migration: mkdocs-material 페이지 네비 + NHN Cloud 정보 푸터

  구조:
    1. mkdocs-material 페이지 네비게이션 (Previous/Next)
    2. NHN Cloud 정보 푸터 (회사정보/약관/Copyright)
-#}

{# ============================================================
   1. mkdocs-material 페이지 네비게이션 (Previous/Next)
   ============================================================ #}
<footer class="md-footer">
  {% if page.previous_page or page.next_page %}
    {% if page.meta and page.meta.hide %}
      {% set hidden = "hidden" if "footer" in page.meta.hide %}
    {% endif %}
    <nav class="md-footer__inner md-grid" aria-label="{{ lang.t('footer.title') }}" {{ hidden }}>

      {# 이전 페이지 #}
      {% if page.previous_page %}
        {% set direction = lang.t("footer.previous") %}
        <a href="{{ page.previous_page.url | url }}"
           class="md-footer__link md-footer__link--prev"
           aria-label="{{ direction }}: {{ page.previous_page.title | e }}"
           rel="prev">
          <div class="md-footer__button md-icon">
            {% include ".icons/material/arrow-left.svg" %}
          </div>
          <div class="md-footer__title">
            <div class="md-ellipsis">
              <span class="md-footer__direction">
                {{ direction }}
              </span>
              {{ page.previous_page.title }}
            </div>
          </div>
        </a>
      {% endif %}

      {# 다음 페이지 #}
      {% if page.next_page %}
        {% set direction = lang.t("footer.next") %}
        <a href="{{ page.next_page.url | url }}"
           class="md-footer__link md-footer__link--next"
           aria-label="{{ direction }}: {{ page.next_page.title | e }}"
           rel="next">
          <div class="md-footer__title">
            <div class="md-ellipsis">
              <span class="md-footer__direction">
                {{ direction }}
              </span>
              {{ page.next_page.title }}
            </div>
          </div>
          <div class="md-footer__button md-icon">
            {% include ".icons/material/arrow-right.svg" %}
          </div>
        </a>
      {% endif %}
    </nav>
  {% endif %}

  {# ============================================================
     2. NHN Cloud 정보 푸터
     ============================================================ #}
  <div class="nhn-footer">
    <div class="nhn-footer__inner md-grid">

      {# 좌측: NHN Cloud 정보 #}
      <div class="nhn-footer__brand">
        <div class="nhn-footer__logo">NHN Cloud</div>
        <div class="nhn-footer__company">
          NHN Cloud Corp.
        </div>
        <div class="nhn-footer__address">
          (13487) 경기도 성남시 분당구 대왕판교로 645번길 16, NHN Pangyo
        </div>
      </div>

      {# 중앙: 링크 메뉴 #}
      <nav class="nhn-footer__menu" aria-label="NHN Cloud Footer Links">
        <div class="nhn-footer__menu-group">
          <h4 class="nhn-footer__menu-title">서비스</h4>
          <ul>
            <li><a href="https://www.nhncloud.com/kr/service" target="_blank" rel="noopener">전체 서비스</a></li>
            <li><a href="https://www.nhncloud.com/kr/pricing" target="_blank" rel="noopener">요금</a></li>
            <li><a href="https://docs.nhncloud.com" target="_blank" rel="noopener">사용자 가이드</a></li>
          </ul>
        </div>

        <div class="nhn-footer__menu-group">
          <h4 class="nhn-footer__menu-title">고객 지원</h4>
          <ul>
            <li><a href="https://www.nhncloud.com/kr/support" target="_blank" rel="noopener">고객 센터</a></li>
            <li><a href="https://www.nhncloud.com/kr/notice" target="_blank" rel="noopener">공지사항</a></li>
            <li><a href="https://meetup.nhncloud.com" target="_blank" rel="noopener">기술 블로그</a></li>
          </ul>
        </div>

        <div class="nhn-footer__menu-group">
          <h4 class="nhn-footer__menu-title">정책 및 약관</h4>
          <ul>
            <li><a href="https://www.nhncloud.com/kr/policy/terms" target="_blank" rel="noopener">서비스 이용 약관</a></li>
            <li><a href="https://www.nhncloud.com/kr/policy/privacy" target="_blank" rel="noopener">개인정보 처리방침</a></li>
            <li><a href="https://www.nhncloud.com/kr/policy/sla" target="_blank" rel="noopener">SLA</a></li>
          </ul>
        </div>
      </nav>

    </div>

    {# 하단: Copyright #}
    <div class="nhn-footer__meta">
      <div class="nhn-footer__meta-inner md-grid">
        <span class="nhn-footer__copyright">
          Copyright © {{ build_date_utc.year }} NHN Cloud Corp. All rights reserved.
        </span>
        <span class="nhn-footer__poweredby">
          {% if config.copyright %}
            {{ config.copyright }}
          {% else %}
            Made with mkdocs-material
          {% endif %}
        </span>
      </div>
    </div>
  </div>
</footer>
